/* 地图页专属样式(其余复用 app.wxss 全局类) */
.map-title {
  font-size: 76rpx;
  color: #2c6e49;
}
.map-reset-btn {
  position: relative;
  overflow: hidden;
  min-height: 128rpx;
  font-size: 40rpx;
  box-shadow: 0 12rpx 0 #d96f00;
}
/* 长按充能填充:2s 线性从左铺满,与 JS 定时同步;松手即随 wx:if 撤销 */
.reset-fill {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 107, 129, 0.45);
  border-radius: inherit;
  transform-origin: left center;
  animation: reset-fill 2s linear forwards;
}
@keyframes reset-fill {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}
/* 锁定单元:替代原生 disabled 灰显(改为可点击,给摇头+toast 反馈) */
.unit-btn.locked {
  filter: grayscale(0.8);
}

/* 大屏平板竖屏:rpx 随宽度放大导致头部/底部固定元素占高过多、滚动区只剩一行多。
   收紧地图页各元素尺寸,把高度还给单元网格 */
@media (min-width: 600px) {
  .map-title {
    font-size: 48rpx;
  }
  .learned-bar {
    font-size: 30rpx;
    padding: 8rpx 32rpx 14rpx;
  }
  .learned-bar .track {
    height: 20rpx;
    margin-top: 8rpx;
  }
  .unit-scroll {
    padding: 4rpx 12rpx;
  }
  .unit-grid {
    gap: 20rpx;
  }
  .unit-btn {
    min-width: 230rpx;
    min-height: 150rpx;
    font-size: 34rpx;
    border-radius: 40rpx;
  }
  .unit-btn .star {
    font-size: 32rpx;
  }
  .map-reset-btn {
    min-height: 84rpx;
    font-size: 28rpx;
    box-shadow: 0 8rpx 0 #d96f00;
  }
  .full-fixed {
    gap: 20rpx;
  }
}

/* 阶段页签 */
.stage-tabs {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx;
}
.stage-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 36rpx;
  border-radius: 32rpx;
  background: #e8f0e2;
  color: #2c6e49;
  border: 4rpx solid transparent;
}
.stage-tab.active {
  background: #2c6e49;
  color: #fff;
}
.stage-tab.locked {
  background: #eee;
  color: #aaa;
}
/* 阶段标题与阶段进度条 */
.stage-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 16rpx 32rpx 0;
}
.stage-name {
  font-size: 44rpx;
  color: #2c6e49;
  font-weight: bold;
}
.stage-age {
  font-size: 28rpx;
  color: #888;
}
.stage-bar {
  font-size: 30rpx;
  color: #555;
  padding: 8rpx 32rpx 12rpx;
}
.stage-bar .track {
  height: 22rpx;
  margin-top: 6rpx;
  background: #e8f5e9;
  border-radius: 999rpx;
  overflow: hidden;
}
.stage-bar .fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #7ed957, #4caf50);
  transition: width 0.4s;
}
/* 复习单元卡片 */
.review-btn {
  box-shadow: 0 10rpx 0 #7c5cbf;
}
