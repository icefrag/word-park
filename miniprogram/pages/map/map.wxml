<view class="center full-fixed">
  <view class="map-title" bindtap="speak" hover-class="press">选一关开始吧</view>
  <!-- 已认字进度条:learned 为已通关单元的字数和 -->
  <view class="learned-bar">
    <view>已认字 {{learned}}/{{total}}</view>
    <view class="track">
      <view class="fill" style="width: {{learnedPct}}%"></view>
    </view>
  </view>
  <!-- 阶段页签:锁定的灰显带锁 -->
  <view class="stage-tabs">
    <view
      wx:for="{{stages}}"
      wx:key="id"
      class="stage-tab {{item.id === activeStage ? 'active' : ''}} {{item.unlocked ? '' : 'locked'}} {{shakeStage === item.id ? 'shake' : ''}}"
      data-id="{{item.id}}"
      bindtap="switchStage"
      hover-class="press"
    >
      {{item.name}}{{item.unlocked ? '' : ' 🔒'}}
    </view>
  </view>
  <!-- 当前阶段:标题 + 阶段进度 + 单元卡片网格 -->
  <scroll-view class="unit-scroll" scroll-y>
    <block wx:for="{{stages}}" wx:key="id" wx:for-item="stage">
      <view wx:if="{{stage.id === activeStage}}">
        <view class="stage-head">
          <text class="stage-name">{{stage.name}} · {{stage.subtitle}}</text>
          <text class="stage-age">{{stage.age}}</text>
        </view>
        <view class="stage-bar">
          <view>{{stage.done}}/{{stage.total}}</view>
          <view class="track">
            <view class="fill" style="width: {{stage.pct}}%"></view>
          </view>
        </view>
        <view class="unit-grid">
          <button
            wx:for="{{stage.units}}"
            wx:key="id"
            class="big-btn unit-btn {{item.green ? 'green' : ''}} {{item.review ? 'review-btn' : ''}} {{item.locked ? 'locked' : ''}} {{shakeId === item.id ? 'shake' : ''}}"
            data-id="{{item.id}}"
            data-locked="{{item.locked}}"
            bindtap="play"
          >
            <view style="font-size: 40rpx">{{item.review ? '🔁 ' : ''}}{{item.theme}}</view>
            <view>
              <text wx:for="{{[1, 2, 3]}}" wx:for-item="s" wx:key="*this" class="star {{s > item.stars ? 'empty' : ''}}">★</text>
            </view>
            <view wx:if="{{item.locked}}" style="font-size: 64rpx">🔒</view>
          </button>
        </view>
      </view>
    </block>
  </scroll-view>
  <button
    class="big-btn map-reset-btn"
    bindtap="onResetTap"
    bindtouchstart="onResetStart"
    bindtouchend="onResetEnd"
    bindtouchcancel="onResetEnd"
  >
    <view wx:if="{{resetArming}}" class="reset-fill"></view>
    <text>重新开始(家长按钮)</text>
  </button>

  <view class="voice-gear" bindtap="openSettings" hover-class="press">⚙</view>
  <view class="settings-mask" wx:if="{{settingsOpen}}" bindtap="closeSettings">
    <view class="settings-panel" catchtap="noop">
      <view class="settings-title">换个声音陪你学</view>
      <view class="voice-row {{voiceKey === v.key ? 'on' : ''}}" wx:for="{{voices}}" wx:for-item="v" wx:key="key" data-key="{{v.key}}" bindtap="pickVoice" hover-class="press">
        <text>{{v.name}}</text>
        <text wx:if="{{voiceKey === v.key}}">✓</text>
      </view>
    </view>
  </view>
</view>
