<view class="center full" style="position: relative; overflow: hidden">
  <view
    wx:for="{{confetti}}"
    wx:key="index"
    class="confetti"
    style="left: {{item.left}}%; background: {{item.color}}; animation-delay: {{item.delay}}s"
  ></view>
  <image class="bounce reward-panda" src="{{pandaImage}}" mode="aspectFit" bindtap="speak" hover-class="press" />
  <view class="reward-title">{{theme}} 过关啦!</view>
  <view class="reward-stars">
    <text wx:for="{{[1, 2, 3]}}" wx:for-item="s" wx:key="*this" class="star pop {{s > stars ? 'empty' : ''}}">★</text>
  </view>
  <button class="big-btn green" bindtap="back">回到地图</button>
</view>
