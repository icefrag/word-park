/* 首页(开机欢迎页):AI 背景图 + 错峰入场动画,点熊猫可重听欢迎语 */
.welcome {
  position: relative;
  width: 100%;
  height: 100vh;
}
.welcome-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.welcome-content {
  position: relative;
}
.home-panda {
  width: 440rpx;
  height: 440rpx;
  filter: drop-shadow(0 12rpx 24rpx rgba(0, 0, 0, 0.18));
}
.home-title {
  font-size: 128rpx;
  font-weight: bold;
  letter-spacing: 8rpx;
  color: #2c6e49;
  text-shadow: 0 4rpx 0 #fff, 0 8rpx 20rpx rgba(255, 255, 255, 0.8);
}
.home-sub {
  font-size: 44rpx;
  color: #4a6b57;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 999rpx;
  padding: 10rpx 44rpx;
}

/* 错峰入场:logo 弹出,文案与按钮依次浮现 */
.enter {
  animation: enter-up 0.6s ease-out backwards;
}
.home-title.enter { animation-delay: 0.25s; }
.home-sub.enter { animation-delay: 0.45s; }
.big-btn.enter { animation-delay: 0.65s; }
@keyframes enter-up {
  from {
    opacity: 0;
    transform: translateY(40rpx) scale(0.92);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* 平板大屏:尺寸缩回接近手机像素 */
@media (min-width: 600px) {
  .home-panda {
    width: 260rpx;
    height: 260rpx;
  }
  .home-title {
    font-size: 76rpx;
  }
  .home-sub {
    font-size: 32rpx;
  }
}
