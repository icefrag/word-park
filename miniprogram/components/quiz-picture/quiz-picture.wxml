<view class="center full">
  <view style="font-size: 64rpx; color: #2c6e49">这是哪个字?</view>
  <image class="card bounce" src="{{image}}" mode="aspectFit" style="width: 480rpx; height: 480rpx; padding: 32rpx" />
  <view style="display: flex; gap: 64rpx">
    <button
      wx:for="{{questions[qi].options}}"
      wx:key="*this"
      class="big-btn {{wrongPick === item ? 'shake' : ''}}"
      style="min-width: 280rpx; font-size: 144rpx"
      data-ch="{{item}}"
      bindtap="pick"
    >
      {{item}}
    </button>
  </view>
  <view wx:if="{{starBurst}}" class="star-burst">⭐</view>
  <button class="speaker-btn" bindtap="repeat">🔊</button>
</view>
