<view class="center full">
  <view style="font-size: 64rpx; color: #2c6e49">这是哪个字?</view>
  <image class="card bounce" src="{{image}}" mode="aspectFit" style="width: 400rpx; height: 400rpx; padding: 32rpx" />
  <view class="options-row">
    <button
      wx:for="{{questions[qi].options}}"
      wx:key="*this"
      class="opt-btn {{wrongPick === item ? 'shake' : ''}}"
      data-ch="{{item}}"
      bindtap="pick"
    >
      {{item}}
    </button>
  </view>
  <view wx:if="{{starBurst}}" class="star-burst">⭐</view>
  <button class="speaker-btn" bindtap="repeat">🔊</button>
</view>
