<view class="center full">
  <view class="quiz-title">这是哪个字?</view>
  <image class="card bounce quiz-image" src="{{image}}" mode="aspectFit" bindtap="repeat" hover-class="press" />
  <view class="options-row">
    <button
      wx:for="{{questions[qi].options}}"
      wx:key="*this"
      class="opt-btn {{wrongPick === item ? 'shake' : ''}}"
      data-ch="{{item}}"
      bindtap="pick"
    >
      {{item}}
    </button>
  </view>
  <view wx:if="{{starBurst}}" class="star-burst">⭐</view>
</view>
