/* 连连看:两列卡片,样式全部自包含不依赖全局类 */
.quiz-title {
  font-size: 64rpx;
  color: #2c6e49;
}
.link-board {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
}
.link-col {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.link-card {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  background: #fff;
  border: 6rpx solid #ffd54f;
  border-radius: 32rpx;
  box-shadow: 0 10rpx 0 #e0b93f;
  transition: border-color 0.15s, box-shadow 0.15s;
  display: inline-block;
  text-align: center;
  line-height: 150rpx;
}
.link-card image {
  width: 110rpx;
  height: 110rpx;
  vertical-align: middle;
}
.link-card.selected {
  border-color: #ff8c1a;
  box-shadow: 0 0 0 10rpx rgba(255, 180, 64, 0.4);
}
.link-card.done {
  background: #e2f7d8;
  border-color: #7ed957;
  box-shadow: none;
  opacity: 0.35;
}
.link-card.done::after {
  /* 右上角对勾角标 */
  content: '✔';
  position: absolute;
  top: 2rpx;
  right: 12rpx;
  font-size: 44rpx;
  color: #2e7d32;
}
.link-char {
  font-size: 72rpx;
  color: #333;
}

/* view 卡片的按压反馈(替代 button 原生 :active) */
.cell-hover {
  transform: scale(0.94);
  opacity: 0.9;
}

/* 平板大屏:尺寸缩回接近手机像素 */
@media (min-width: 600px) {
  .quiz-title {
    font-size: 40rpx;
  }
  .link-board {
    gap: 28rpx;
  }
  .link-col {
    gap: 14rpx;
  }
  .link-card {
    width: 100rpx;
    height: 100rpx;
    border: 4rpx solid #ffd54f;
    border-radius: 22rpx;
    box-shadow: 0 7rpx 0 #e0b93f;
    line-height: 100rpx;
  }
  .link-card image {
    width: 74rpx;
    height: 74rpx;
  }
  .link-card.selected {
    box-shadow: 0 0 0 7rpx rgba(255, 180, 64, 0.4);
  }
  .link-card.done::after {
    top: 1rpx;
    right: 8rpx;
    font-size: 30rpx;
  }
  .link-char {
    font-size: 48rpx;
  }
}
