<view class="center full">
  <view class="quiz-title" bindtap="speak" hover-class="press">把字和图片连起来</view>
  <view class="round-bar"><view class="fill" style="width: {{matchedN / charCards.length * 100}}%"></view></view>
  <view class="link-board">
    <view class="link-col">
      <view
        wx:for="{{charCards}}"
        wx:key="key"
        class="link-card {{selected === item.key ? 'selected' : ''}} {{matchedMap[item.char] ? 'done' : ''}} {{wrongPairMap[item.key] ? 'shake' : ''}} {{hintKeyMap[item.key] ? 'hint-glow' : ''}}"
        data-card="{{item}}"
        bindtap="pickChar"
        hover-class="cell-hover"
      >
        <text class="link-char">{{item.char}}</text>
      </view>
    </view>
    <view class="link-col">
      <view
        wx:for="{{imgCards}}"
        wx:key="key"
        class="link-card {{matchedMap[item.char] ? 'done' : ''}} {{wrongPairMap[item.key] ? 'shake' : ''}} {{hintKeyMap[item.key] ? 'hint-glow' : ''}}"
        data-card="{{item}}"
        bindtap="pickImage"
        hover-class="cell-hover"
      >
        <image src="{{item.image}}" mode="aspectFit" class="link-img" />
      </view>
    </view>
  </view>
  <view wx:if="{{starBurst}}" class="star-burst">⭐</view>
</view>
