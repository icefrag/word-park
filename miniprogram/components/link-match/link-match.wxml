<view class="center full">
  <view style="font-size: 64rpx; color: #2c6e49">把字和图片连起来</view>
  <view class="link-board">
    <view class="link-col-char">
      <button
        wx:for="{{charCards}}"
        wx:key="key"
        class="cell-btn link-card {{selected === item.key ? 'selected' : ''}} {{matchedMap[item.char] ? 'done' : ''}} {{wrongPairMap[item.key] ? 'shake' : ''}}"
        data-card="{{item}}"
        bindtap="pickChar"
      >
        <text class="char-display" style="font-size: 128rpx">{{item.char}}</text>
      </button>
    </view>
    <view class="link-col-img">
      <button
        wx:for="{{imgCards}}"
        wx:key="key"
        class="cell-btn link-card {{matchedMap[item.char] ? 'done' : ''}} {{wrongPairMap[item.key] ? 'shake' : ''}}"
        data-card="{{item}}"
        bindtap="pickImage"
      >
        <image src="{{item.image}}" mode="aspectFit" style="width: 240rpx; height: 240rpx" />
      </button>
    </view>
  </view>
  <view wx:if="{{starBurst}}" class="star-burst">⭐</view>
  <button class="speaker-btn" bindtap="speak">🔊</button>
</view>
