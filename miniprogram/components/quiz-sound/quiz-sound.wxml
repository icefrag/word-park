<view class="center full">
  <view style="font-size: 64rpx; color: #2c6e49">听一听,是哪个字?</view>
  <button class="card" style="width: 400rpx; height: 400rpx; font-size: 192rpx; display: flex; align-items: center; justify-content: center" bindtap="playTarget">🔊</button>
  <view class="options-row">
    <button
      wx:for="{{questions[qi].options}}"
      wx:key="*this"
      class="opt-btn {{wrongPick === item ? 'shake' : ''}}"
      data-ch="{{item}}"
      bindtap="pick"
    >
      {{item}}
    </button>
  </view>
  <view wx:if="{{starBurst}}" class="star-burst">⭐</view>
</view>
