<view class="center full">
  <view class="quiz-title">听一听,是哪个字?</view>
  <view class="round-bar"><view class="fill" style="width: {{(qi + 1) / questions.length * 100}}%"></view></view>
  <button class="card sound-btn-card" bindtap="playTarget">🔊</button>
  <view class="options-row">
    <button
      wx:for="{{questions[qi].options}}"
      wx:key="*this"
      class="opt-btn {{wrongPick === item ? 'shake' : ''}}"
      data-ch="{{item}}"
      bindtap="pick"
    >
      {{item}}
    </button>
  </view>
  <view wx:if="{{starBurst}}" class="star-burst">⭐</view>
</view>
