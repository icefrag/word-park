/* 识字卡:整卡可点读(右上角小 🔊 提示) */
.flash-box {
  position: relative;
  padding: 48rpx 96rpx;
  gap: 20rpx;
}
.flash-hint {
  position: absolute;
  top: 16rpx;
  right: 24rpx;
  font-size: 40rpx;
  opacity: 0.45;
}
.flash-char {
  font-size: 224rpx;
  line-height: 1.1;
  color: #333;
}
.flash-pinyin {
  font-size: 44rpx;
  color: #888;
}
.flash-img {
  width: 280rpx;
  height: 280rpx;
}
.flash-word {
  font-size: 64rpx;
  color: #444;
}

/* 识字卡"下一个"按钮:胶囊形 + 光泽渐变 + 轻微呼吸动画吸引点击 */
.next-btn {
  min-width: 420rpx;
  min-height: 150rpx;
  padding: 0 80rpx;
  font-size: 56rpx;
  color: #fff;
  background: linear-gradient(180deg, #ffd24d 0%, #ff9f1a 55%, #ff8c1a 100%);
  border: 6rpx solid #fff;
  border-radius: 999rpx;
  box-shadow: 0 14rpx 0 #d96f00, 0 24rpx 48rpx rgba(217, 111, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: next-breathe 2s ease-in-out infinite;
}
.next-btn:active {
  animation: none;
  transform: translateY(10rpx);
  box-shadow: 0 4rpx 0 #d96f00;
}
@keyframes next-breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.04); }
}

/* 平板大屏:尺寸缩回接近手机像素 */
@media (min-width: 600px) {
  .flash-box {
    padding: 24rpx 56rpx;
    gap: 12rpx;
  }
  .flash-hint {
    top: 10rpx;
    right: 14rpx;
    font-size: 26rpx;
  }
  .flash-char {
    font-size: 130rpx;
  }
  .flash-pinyin {
    font-size: 28rpx;
  }
  .flash-img {
    width: 170rpx;
    height: 170rpx;
  }
  .flash-word {
    font-size: 40rpx;
  }
  .next-btn {
    min-width: 260rpx;
    min-height: 92rpx;
    padding: 0 48rpx;
    font-size: 36rpx;
    box-shadow: 0 8rpx 0 #d96f00, 0 14rpx 28rpx rgba(217, 111, 0, 0.35);
  }
  .next-btn:active {
    transform: translateY(6rpx);
    box-shadow: 0 3rpx 0 #d96f00;
  }
}
