<view class="center full">
  <view wx:if="{{showCard}}" class="card center pop flash-box" bindtap="speak" hover-class="press">
    <text class="flash-hint">🔊</text>
    <view class="flash-char">{{chars[idx].char}}</view>
    <view class="flash-pinyin">{{chars[idx].pinyin}}</view>
    <image class="bounce flash-img" src="{{image}}" mode="aspectFit" />
    <view class="flash-word">{{chars[idx].word}}的{{chars[idx].char}}</view>
  </view>
  <button class="next-btn" bindtap="next">{{idx < chars.length - 1 ? '下一个 ➜' : '学完啦 🎉'}}</button>
</view>
