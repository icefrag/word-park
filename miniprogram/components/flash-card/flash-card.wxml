<view class="center full">
  <view wx:if="{{showCard}}" class="card center pop" style="padding: 48rpx 96rpx; gap: 20rpx" bindtap="speak">
    <view class="char-display" style="font-size: 224rpx">{{chars[idx].char}}</view>
    <view style="font-size: 44rpx; color: #888">{{chars[idx].pinyin}}</view>
    <image class="bounce" src="{{image}}" mode="aspectFit" style="width: 320rpx; height: 320rpx" />
    <view style="font-size: 64rpx; color: #444">{{chars[idx].word}}的{{chars[idx].char}}</view>
  </view>
  <button class="next-btn" bindtap="next">{{idx < chars.length - 1 ? '下一个 ➜' : '学完啦 🎉'}}</button>
  <button class="speaker-btn" bindtap="speak">🔊</button>
</view>
