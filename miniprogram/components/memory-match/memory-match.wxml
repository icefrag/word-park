<view class="center full">
  <view style="font-size: 64rpx; color: #2c6e49">字和图片配成一对</view>
  <view class="match-row" wx:for="{{rows}}" wx:key="index" wx:for-item="row">
    <button
      wx:for="{{row}}"
      wx:key="i"
      wx:for-item="cell"
      class="match-cell {{flippedMap[cell.i] || matchedMap[cell.char] ? 'open' : ''}} {{wrongPairMap[cell.i] ? 'shake' : ''}}"
      data-cell="{{cell}}"
      bindtap="flip"
    >
      <block wx:if="{{flippedMap[cell.i] || matchedMap[cell.char]}}">
        <image wx:if="{{cell.kind === 'image'}}" src="{{cell.image}}" mode="aspectFit" style="width: 120rpx; height: 120rpx" />
        <text wx:else class="match-char">{{cell.char}}</text>
      </block>
      <text wx:else class="match-back">🐼</text>
    </button>
  </view>
  <view wx:if="{{starBurst}}" class="star-burst">⭐</view>
  <button class="speaker-btn" bindtap="speak">🔊</button>
</view>
