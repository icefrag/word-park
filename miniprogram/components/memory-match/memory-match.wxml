<view class="center full">
  <view style="font-size: 64rpx; color: #2c6e49">字和图片配成一对</view>
  <view style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 40rpx">
    <button
      wx:for="{{view}}"
      wx:key="key"
      class="cell-btn {{flippedMap[index] || matchedMap[item.char] ? 'open' : ''}} {{wrongPairMap[index] ? 'shake' : ''}}"
      data-i="{{index}}"
      bindtap="flip"
    >
      <block wx:if="{{flippedMap[index] || matchedMap[item.char]}}">
        <image wx:if="{{item.kind === 'image'}}" src="{{item.image}}" mode="aspectFit" style="width: 192rpx; height: 192rpx" />
        <text wx:else class="char-display" style="font-size: 128rpx">{{item.char}}</text>
      </block>
      <text wx:else style="font-size: 96rpx">🐼</text>
    </button>
  </view>
  <view wx:if="{{starBurst}}" class="star-burst">⭐</view>
  <button class="speaker-btn" bindtap="speak">🔊</button>
</view>
