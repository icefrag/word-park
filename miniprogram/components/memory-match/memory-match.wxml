<view class="center full">
  <view style="font-size: 64rpx; color: #2c6e49">字和图片配成一对</view>
  <view class="match-grid">
    <button
      wx:for="{{view}}"
      wx:key="key"
      class="match-cell {{flippedMap[index] || matchedMap[item.char] ? 'open' : ''}} {{wrongPairMap[index] ? 'shake' : ''}}"
      data-i="{{index}}"
      bindtap="flip"
    >
      <block wx:if="{{flippedMap[index] || matchedMap[item.char]}}">
        <image wx:if="{{item.kind === 'image'}}" src="{{item.image}}" mode="aspectFit" style="width: 120rpx; height: 120rpx" />
        <text wx:else class="match-char">{{item.char}}</text>
      </block>
      <text wx:else class="match-back">🐼</text>
    </button>
  </view>
  <view wx:if="{{starBurst}}" class="star-burst">⭐</view>
  <button class="speaker-btn" bindtap="speak">🔊</button>
</view>
