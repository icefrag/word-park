<view class="center full">
  <view class="quiz-title" bindtap="speak" hover-class="press">字和图片配成一对</view>
  <view class="round-bar"><view class="fill" style="width: {{matchedN / (cards.length / 2) * 100}}%"></view></view>
  <view class="match-board" style="width: {{boardW}}px; height: {{boardH}}px">
    <view
      wx:for="{{cells}}"
      wx:key="i"
      class="match-cell {{flippedMap[item.i] || matchedMap[item.char] ? 'open' : ''}} {{wrongPairMap[item.i] ? 'shake' : ''}} {{hintPairMap[item.i] ? 'hint-glow' : ''}}"
      style="left: {{item.left}}px; top: {{item.top}}px; width: {{cell}}px; height: {{cell}}px; line-height: {{cell}}px"
      data-cell="{{item}}"
      bindtap="flip"
      hover-class="cell-hover"
    >
      <block wx:if="{{flippedMap[item.i] || matchedMap[item.char]}}">
        <image wx:if="{{item.kind === 'image'}}" src="{{item.image}}" mode="aspectFit" style="width: {{imgSize}}px; height: {{imgSize}}px" />
        <text wx:else class="match-char" style="font-size: {{charFont}}px">{{item.char}}</text>
      </block>
      <text wx:else class="match-back" style="font-size: {{backFont}}px">🐼</text>
    </view>
  </view>
  <view wx:if="{{starBurst}}" class="star-burst">⭐</view>
</view>
