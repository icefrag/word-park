/* 翻牌配对:JS 切行(2 行×4 列),样式全部自包含不依赖全局类 */
.match-row {
  display: flex;
  justify-content: center;
}
.match-cell {
  width: 160rpx;
  height: 160rpx;
  margin: 10rpx;
  /* 行内块兜底:即使 flex 异常也保持横排 */
  display: inline-block;
  background: #fff7e0;
  border: 6rpx solid #ffd54f;
  border-radius: 32rpx;
  text-align: center;
  line-height: 160rpx;
}
.match-cell.open {
  background: #fff;
  border-color: #7ed957;
}
.match-cell image {
  vertical-align: middle;
}
.match-char {
  font-size: 96rpx;
  color: #333;
}
.match-back {
  font-size: 72rpx;
}
