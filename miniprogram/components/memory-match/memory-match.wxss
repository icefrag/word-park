/* 翻牌配对:绝对定位棋盘(坐标 JS 计算),不依赖 flex/grid */
.match-board {
  position: relative;
}
.match-cell {
  position: absolute;
  width: 150rpx;
  height: 150rpx;
  background: #fff7e0;
  border: 6rpx solid #ffd54f;
  border-radius: 32rpx;
  text-align: center;
  line-height: 150rpx;
}
.match-cell.open {
  background: #fff;
  border-color: #7ed957;
}
.match-char {
  font-size: 84rpx;
  color: #333;
}
.match-back {
  font-size: 64rpx;
}
