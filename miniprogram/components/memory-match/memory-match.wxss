.quiz-title {
  font-size: 64rpx;
  color: #2c6e49;
}
/* 翻牌配对:绝对定位棋盘(坐标与尺寸 JS 计算 px,随屏宽缩放封顶) */
.match-board {
  position: relative;
}
.match-cell {
  position: absolute;
  box-sizing: border-box; /* 边框算进宽高,避免占位超出坐标间距 */
  background: #fff7e0;
  border: 6rpx solid #ffd54f;
  border-radius: 36rpx;
  text-align: center;
}
.match-cell.open {
  background: #fff;
  border-color: #7ed957;
}
.match-cell image {
  vertical-align: middle;
}
.match-char {
  color: #333;
}

/* view 卡片的按压反馈(替代 button 原生 :active) */
.cell-hover {
  transform: scale(0.94);
  opacity: 0.9;
}

/* 平板大屏:标题与边框装饰缩小(牌面尺寸由 JS px 控制) */
@media (min-width: 600px) {
  .quiz-title {
    font-size: 40rpx;
  }
  .match-cell {
    border: 4rpx solid #ffd54f;
    border-radius: 24rpx;
  }
}
