/* 翻牌配对:绝对定位棋盘(坐标 JS 计算),3 列排布 3+3+2 */
.match-board {
  position: relative;
}
.match-cell {
  position: absolute;
  width: 170rpx;
  height: 170rpx;
  box-sizing: border-box; /* 边框算进宽高,避免占位超出坐标间距 */
  background: #fff7e0;
  border: 6rpx solid #ffd54f;
  border-radius: 36rpx;
  text-align: center;
  line-height: 170rpx;
}
.match-cell.open {
  background: #fff;
  border-color: #7ed957;
}
/* 图片尺寸必须写在样式表:行内 style 的尺寸在 button 内不生效 */
.match-cell image {
  width: 126rpx;
  height: 126rpx;
  vertical-align: middle;
}
.match-char {
  font-size: 96rpx;
  color: #333;
}
.match-back {
  font-size: 72rpx;
}
