/* 翻牌配对:4 列小卡(160rpx),flex 换行布局(grid 在部分环境列塌缩) */
.match-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 24rpx;
}
.match-cell {
  width: 160rpx;
  height: 160rpx;
  background: #fff7e0;
  border: 6rpx solid #ffd54f;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.match-cell.open {
  background: #fff;
  border-color: #7ed957;
}
.match-char {
  font-size: 96rpx;
  line-height: 1.1;
  color: #333;
}
.match-back {
  font-size: 72rpx;
}
