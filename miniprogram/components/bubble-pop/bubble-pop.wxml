<view class="center full" style="position: relative; overflow: hidden">
  <view class="quiz-title prompt" bindtap="speakTarget" hover-class="press">
    点<text class="target-char">{{target || '?'}}</text>泡泡<text class="hint-icon">🔊</text>
    <text class="score-text">{{score}} / {{targets.length}}</text>
  </view>
  <button
    wx:for="{{bubbles}}"
    wx:key="id"
    class="bubble {{wrongId === item.id ? 'shake' : ''}}"
    style="left: {{item.left}}%; animation-duration: {{item.dur}}s"
    data-id="{{item.id}}"
    bindtap="pop"
  >
    {{item.char}}
  </button>
  <view wx:if="{{starBurst}}" class="star-burst">⭐</view>
</view>
