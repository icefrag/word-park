/* 找一找:九宫格改 flex 换行(grid 在部分环境列塌缩),3 列自动排布 */
.findall-card {
  width: 100%;
  box-sizing: border-box;
  border-radius: 48rpx;
}
.findall-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 24rpx;
  padding: 32rpx;
  box-sizing: border-box;
}
.findall-char {
  font-size: 96rpx;
  line-height: 1.1;
  color: #333;
}
