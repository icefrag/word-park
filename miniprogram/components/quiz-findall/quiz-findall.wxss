/* 找一找:绝对定位棋盘(坐标 JS 计算),不依赖 flex/grid */
.findall-card {
  border-radius: 48rpx;
  padding: 20rpx;
}
.findall-board {
  position: relative;
  margin: 0 auto;
}
.findall-cell {
  position: absolute;
  width: 150rpx;
  height: 150rpx;
  background: #fff7e0;
  border: 6rpx solid #ffd54f;
  border-radius: 32rpx;
  text-align: center;
  line-height: 150rpx;
}
.findall-cell.found {
  background: #e2f7d8;
  border-color: #7ed957;
}
.findall-char {
  font-size: 76rpx;
  color: #333;
}
.findall-star {
  font-size: 60rpx;
  color: #ffc400;
}
