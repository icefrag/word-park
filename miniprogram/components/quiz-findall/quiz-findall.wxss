/* 找一找:九宫格 flex 换行(3 列),格子 160rpx 单屏装下 */
.findall-card {
  width: 100%;
  box-sizing: border-box;
  border-radius: 48rpx;
}
.findall-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
}
.findall-char {
  font-size: 80rpx;
  line-height: 1.1;
  color: #333;
}
