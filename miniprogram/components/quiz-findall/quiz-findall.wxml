<view class="center full">
  <view style="font-size: 64rpx; color: #2c6e49">
    找出所有的 <text class="char-display" style="font-size: 96rpx">{{grids[gi].target.char}}</text>
  </view>
  <view class="card findall-card">
    <view class="findall-grid">
      <button
        wx:for="{{grids[gi].cells}}"
        wx:key="index"
        class="cell-btn {{wrongCell === index ? 'shake' : ''}} {{foundMap[index] ? 'found' : ''}}"
        data-i="{{index}}"
        bindtap="clickCell"
      >
        <text wx:if="{{foundMap[index]}}" class="star" style="font-size: 80rpx">★</text>
        <text wx:else class="findall-char">{{item}}</text>
      </button>
    </view>
  </view>
  <button class="speaker-btn" bindtap="repeat">🔊</button>
</view>
