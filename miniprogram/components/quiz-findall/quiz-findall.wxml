<view class="center full">
  <view style="font-size: 64rpx; color: #2c6e49">
    找出所有的 <text class="char-display" style="font-size: 96rpx">{{grids[gi].target.char}}</text>
  </view>
  <view class="card findall-card">
    <view class="findall-board" style="width: {{boardW}}rpx; height: {{boardH}}rpx">
      <button
        wx:for="{{cells}}"
        wx:key="i"
        class="findall-cell {{wrongCell === item.i ? 'shake' : ''}} {{foundMap[item.i] ? 'found' : ''}}"
        style="left: {{item.left}}rpx; top: {{item.top}}rpx"
        data-i="{{item.i}}"
        bindtap="clickCell"
      >
        <text wx:if="{{foundMap[item.i]}}" class="findall-star">★</text>
        <text wx:else class="findall-char">{{item.ch}}</text>
      </button>
    </view>
  </view>
  <button class="speaker-btn" bindtap="repeat">🔊</button>
</view>
