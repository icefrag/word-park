<view class="center full">
  <view class="quiz-title" bindtap="repeat" hover-class="press">
    <block wx:if="{{voice}}">🔊 听一听,找出所有的字</block>
    <block wx:else>找出所有的 <text class="target-char">{{grids[gi].target.char}}</text></block>
  </view>
  <view class="round-bar"><view class="fill" style="width: {{(gi + 1) / grids.length * 100}}%"></view></view>
  <view class="card findall-card">
    <view class="findall-board" style="width: {{boardW}}px; height: {{boardH}}px">
      <view
        wx:for="{{cells}}"
        wx:key="i"
        class="findall-cell {{wrongCell === item.i ? 'shake' : ''}} {{foundMap[item.i] ? 'found' : ''}} {{pulseMap[item.i] ? 'hint-glow' : ''}}"
        style="left: {{item.left}}px; top: {{item.top}}px; width: {{cell}}px; height: {{cell}}px; line-height: {{cell}}px"
        data-i="{{item.i}}"
        bindtap="clickCell"
        hover-class="cell-hover"
      >
        <text wx:if="{{foundMap[item.i]}}" class="findall-star" style="font-size: {{starFont}}px">★</text>
        <text wx:else class="findall-char" style="font-size: {{charFont}}px">{{item.ch}}</text>
      </view>
    </view>
  </view>
</view>
