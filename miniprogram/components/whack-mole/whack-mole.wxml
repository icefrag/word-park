<view class="center full">
  <view class="quiz-title prompt" bindtap="speakTarget" hover-class="press">
    <block wx:if="{{voice}}">🔊 听一听,敲那个字</block>
    <block wx:else>敲<text class="target-char">{{target || '?'}}</text>地鼠<text class="hint-icon">🔊</text></block>
  </view>
  <view class="round-bar"><view class="fill" style="width: {{score / targets.length * 100}}%"></view></view>
  <view class="mole-grid">
    <view wx:for="{{moles}}" wx:key="index" class="hole">
      <text wx:if="{{hammerIndex === index}}" class="hammer">🔨</text>
      <button
        wx:if="{{item}}"
        class="mole-btn {{wrongIndex === index ? 'shake' : ''}}"
        data-i="{{index}}"
        bindtap="whack"
      >
        <text class="mole-face">🐭</text>
        <text class="mole-char">{{item.char}}</text>
      </button>
    </view>
  </view>
  <view wx:if="{{starBurst}}" class="star-burst">⭐</view>
</view>
